@page "/templates/new"
@page "/templates/{Id:guid}"
@rendermode InteractiveServer
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New template" : template.Name) · BetterThinQ</PageTitle>

<header class="px-4 pt-8 pb-3 sticky top-0 bg-gray-50/95 backdrop-blur z-10 flex items-center justify-between gap-3">
    <a href="/templates" class="text-sm text-blue-600 min-h-[44px] inline-flex items-center">← Back</a>
    <h1 class="text-lg font-semibold truncate">@(IsNew ? "New template" : template.Name)</h1>
    <span class="w-12"></span>
</header>

<div class="px-4 pb-4 space-y-6">
    <div>
        <label class="block text-sm font-medium mb-1">Name</label>
        <input @bind="template.Name" maxlength="40"
               class="w-full rounded-lg border border-gray-300 px-3 py-3 text-base focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
               placeholder="Night" />
    </div>

    <p class="text-xs text-gray-500 -mt-2">Applying a template always turns the AC on.</p>

    <Section Title="Mode" OnClear="@(() => template.Mode = null)" HasValue="@(template.Mode is not null)">
        <div class="grid grid-cols-5 gap-2">
            @foreach (var m in Enum.GetValues<AcMode>())
            {
                <button type="button" @onclick="() => template.Mode = m"
                        class="@PillClass(template.Mode == m)">@m</button>
            }
        </div>
    </Section>

    <Section Title="Target temperature" OnClear="@(() => template.TargetTemperatureC = null)" HasValue="@(template.TargetTemperatureC is not null)">
        <div class="flex items-center gap-3">
            <input type="range" min="16" max="30" step="1"
                   value="@(template.TargetTemperatureC ?? 22)"
                   @oninput="OnTempInput"
                   class="flex-1" />
            <div class="w-16 text-right text-lg font-mono">@(template.TargetTemperatureC ?? 22)°C</div>
        </div>
    </Section>

    <Section Title="Fan speed" OnClear="@(() => template.FanSpeed = null)" HasValue="@(template.FanSpeed is not null)">
        <div class="grid grid-cols-3 gap-2">
            @foreach (var f in Enum.GetValues<AcFanSpeed>())
            {
                <button type="button" @onclick="() => template.FanSpeed = f"
                        class="@PillClass(template.FanSpeed == f)">@f</button>
            }
        </div>
    </Section>

    @if (error is not null)
    {
        <div class="rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm p-3">@error</div>
    }

    <div class="grid grid-cols-2 gap-3 pt-2">
        @if (!IsNew)
        {
            <button type="button" @onclick="Delete"
                    class="min-h-[44px] inline-flex items-center justify-center bg-white border border-red-300 text-red-700 font-medium rounded-lg px-4 py-3">
                Delete
            </button>
        }
        else
        {
            <span></span>
        }
        <button type="button" @onclick="Save" disabled="@busy"
                class="min-h-[44px] inline-flex items-center justify-center bg-blue-600 disabled:opacity-60 text-white font-medium rounded-lg px-4 py-3">
            @(busy ? "Saving…" : "Save")
        </button>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private Template template = new();
    private bool busy;
    private string? error;
    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is { } id)
        {
            var existing = await Db.Templates.FirstOrDefaultAsync(t => t.Id == id);
            if (existing is null) { Nav.NavigateTo("/templates"); return; }
            template = existing;
        }
    }

    private void OnTempInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            template.TargetTemperatureC = v;
    }

    private string PillClass(bool active) =>
        "min-h-[44px] inline-flex items-center justify-center rounded-lg text-sm font-medium px-2 py-2 border transition " +
        (active ? "bg-blue-600 text-white border-blue-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50");

    private async Task Save()
    {
        busy = true; error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(template.Name))
            {
                error = "Name is required.";
                return;
            }
            if (IsNew)
            {
                template.Id = Guid.NewGuid();
                Db.Templates.Add(template);
            }
            await Db.SaveChangesAsync();
            Nav.NavigateTo("/templates");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete()
    {
        if (IsNew) return;
        Db.Templates.Remove(template);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/templates");
    }
}
