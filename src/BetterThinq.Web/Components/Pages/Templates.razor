@page "/templates"
@rendermode InteractiveServer
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Templates · BetterThinQ</PageTitle>

<header class="px-4 pt-8 pb-3 sticky top-0 bg-gray-50/95 backdrop-blur z-10 flex items-baseline justify-between">
    <h1 class="text-2xl font-semibold tracking-tight">Templates</h1>
    <a href="/templates/new"
       class="text-sm bg-blue-600 text-white rounded-lg px-3 py-2 min-h-[44px] min-w-[88px] inline-flex items-center justify-center">
        + New
    </a>
</header>

<div class="px-4 space-y-3">
    @if (templates.Count == 0)
    {
        <div class="text-center text-gray-500 py-12 text-sm">
            No templates yet. Tap <strong>+ New</strong> to create one.
        </div>
    }
    @foreach (var t in templates)
    {
        <a href="@($"/templates/{t.Id}")"
           class="block bg-white rounded-xl border border-gray-200 p-4 min-h-[44px] hover:bg-gray-50 active:bg-gray-100 transition">
            <div class="font-medium text-base">@t.Name</div>
            <div class="text-xs text-gray-500 mt-1">@Summarize(t)</div>
        </a>
    }
</div>

@code {
    private List<Template> templates = [];

    protected override async Task OnInitializedAsync()
    {
        templates = await Db.Templates.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
    }

    private static string Summarize(Template t)
    {
        var parts = new List<string>();
        if (t.Mode is { } m) parts.Add(m.ToString());
        if (t.TargetTemperatureC is { } c) parts.Add($"{c}°C");
        if (t.FanSpeed is { } f) parts.Add($"Fan {f}");
        return parts.Count == 0 ? "(power on only)" : string.Join(" · ", parts);
    }
}
